POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RETAILOPS_DATABASE_URL=
STOCKPILOT_BASE_URL=
STOCKPILOT_USERNAME=
STOCKPILOT_PASSWORD=
# Gemini also supports multiple rotating API keys -- at least one is
# required (Gemini is the project's fallback provider). GEMINI_API_KEY
# (no suffix) is accepted as an alias for the first key, for backward
# compatibility with a single-key setup; GEMINI_API_KEY_1 is equivalent
# and preferred for a fresh setup -- same numbered scheme as
# GROQ_API_KEY_N below. llm/providers/gemini.py rotates to the next
# configured key when one hits a 429, before raising a terminal "Gemini
# providers exhausted" error. Add more as needed:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Additional keys may be added later:
# GEMINI_API_KEY_3=
# Groq supports multiple rotating API keys -- at least one is required.
# GROQ_API_KEY (no suffix) is accepted as an alias for the first key, for
# backward compatibility with a single-key setup; GROQ_API_KEY_1 is
# equivalent and preferred for a fresh setup. llm/providers/groq.py
# rotates to the next configured key when one hits a rate limit, before
# failing over to Gemini. Add more as needed:
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Additional keys may be added later:
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
JWT_SECRET=
JWT_ALGORITHM=HS256
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=60.0
LLM_PRIMARY_PROVIDER=groq
