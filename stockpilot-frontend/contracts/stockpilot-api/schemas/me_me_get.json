{
  "$ref": "#/$defs/MeRead",
  "$defs": {
    "MeRead": {
      "properties": {
        "user": {
          "$ref": "#/$defs/UserRead"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Roles"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Permissions"
        }
      },
      "type": "object",
      "required": [
        "user",
        "roles",
        "permissions"
      ],
      "title": "MeRead",
      "description": "docs/ARCHITECTURE.md \u00a76: the ONE call both a profile page and the\nRBAC layer share, not two separate endpoints computing the same\nthing differently. Extended here (Backend Module 10) now that real\nroles/permissions data exists to resolve -- Backend Module 1 shipped\nthis endpoint returning profile only, deliberately, since this data\ndidn't exist yet.",
      "examples": [
        {
          "permissions": [
            "inventory:read",
            "inventory:update",
            "products:read"
          ],
          "roles": [
            "inventory_manager"
          ],
          "user": {
            "created_at": "2026-01-01T00:00:00Z",
            "email": "demo@retailops.local",
            "id": 1,
            "is_active": true,
            "is_read_only": false
          }
        }
      ]
    },
    "UserRead": {
      "properties": {
        "id": {
          "type": "integer",
          "title": "Id"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email"
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active"
        },
        "is_read_only": {
          "type": "boolean",
          "title": "Is Read Only"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Created At"
        }
      },
      "type": "object",
      "required": [
        "id",
        "email",
        "is_active",
        "is_read_only",
        "created_at"
      ],
      "title": "UserRead",
      "examples": [
        {
          "created_at": "2026-01-01T00:00:00Z",
          "email": "demo@retailops.local",
          "id": 1,
          "is_active": true,
          "is_read_only": true
        }
      ]
    }
  }
}
